global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: opensearch
    metrics_path: /_prometheus/metrics
    scheme: https
    tls_config:
      ca_file: {{ os_monitoring_ca_file }}
    basic_auth:
      username: {{ os_monitoring_scrape_user }}
      password: "{{ os_monitoring_scrape_password }}"
    static_configs:
      - targets:
{% for host in groups['lab2'] if hostvars[host].os_short != 'dash' %}
          - "{{ hostvars[host].ansible_host }}:{{ os_port_rest }}"
{% endfor %}
