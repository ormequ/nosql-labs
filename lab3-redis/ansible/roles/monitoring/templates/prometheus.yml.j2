# {{ ansible_managed }}
global:
  scrape_interval: 5s     # lab loads are short, keep the interval short too

scrape_configs:
  - job_name: redis_exporter
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_redis_exporter_port }}"]

  - job_name: rates-api
    static_configs:
      - targets: ["127.0.0.1:{{ app_port }}"]
