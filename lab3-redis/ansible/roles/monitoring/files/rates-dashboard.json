{
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Redis: команд в секунду",
      "type": "timeseries",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[30s])",
          "legendFormat": "ops/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Redis: maxmemory",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "maxmemory",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Redis: память, % от maxmemory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100",
          "legendFormat": "used, % of maxmemory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis: подключенные клиенты",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis: ключей в keyspace",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "sum(redis_db_keys)",
          "legendFormat": "keys",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redis: новые записи slowlog в секунду",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "rate(redis_slowlog_last_id[30s])",
          "legendFormat": "slowlog/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "API: RPS по коду статуса",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(api_requests_total[30s]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "API: p95 задержка по тарифу",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(api_request_latency_seconds_bucket[30s])))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API: доля отклоненных (429) запросов",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(api_requests_total{status=\"429\"}[30s])) / sum(rate(api_requests_total[30s]))",
          "legendFormat": "rejected, %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "API: отклоненные в секунду",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "sum by (tier) (rate(api_requests_total{status=\"429\"}[30s]))",
          "legendFormat": "429 {{tier}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "lab3",
    "redis",
    "rate-limiter"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Lab3: Redis rate limiter",
  "uid": "lab3-redis",
  "version": 1
}
